TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Optional: test bot token for local runs (overrides TELEGRAM_BOT_TOKEN when set)
# TEST_TELEGRAM_BOT_TOKEN=your_test_bot_token
ANTHROPIC_API_KEY=your_anthropic_api_key
ALLOWED_USERS=123456789,987654321

# Telegram IDs for per-user wardrobe profiles
RUSLAN_TELEGRAM_ID=123456789
MARIANA_TELEGRAM_ID=987654321

# Optional: override default DB location
# DB_PATH=/opt/assistant/data/assistant.db

# Optional: MCP server identity (for Claude Code access)
# ASSISTANT_TELEGRAM_ID=0
# ASSISTANT_USERNAME=mcp_user
